# Copy to secret.yaml (git-ignored), fill in the values, then apply it.
apiVersion: v1
kind: Secret
metadata:
  name: client-portal-v2-secret
  namespace: client-portal
  labels:
    app.kubernetes.io/name: client-portal-v2
    app.kubernetes.io/part-of: client-portal
type: Opaque
stringData:
  # Generate with: echo "base64:$(openssl rand -base64 32)"
  APP_KEY: "base64:REPLACE_WITH_REAL_APP_KEY"
  DB_PASSWORD: "REPLACE_WITH_REAL_POSTGRES_PASSWORD"
